---
import Logo from './Logo.astro'
import { APP_URL, demoLink } from '../lib/config.js'
const path = Astro.url.pathname
const cur = (p) => (path === p || path.startsWith(`${p}/`) ? 'page' : undefined)
---
<header class="nav">
  <div class="wrap nav-in">
    <Logo />
    <input type="checkbox" id="menu" class="menu-toggle" aria-label="Abrir menú" />
    <label for="menu" class="menu-btn" aria-hidden="true"><span></span><span></span><span></span></label>
    <nav class="links" aria-label="Principal">
      <a href="/modulos" aria-current={cur('/modulos')}>Módulos</a>
      <a href="/precios" aria-current={cur('/precios')}>Precios</a>
      <a href="/#preguntas">Preguntas</a>
      <a class="ghost" href={`${APP_URL}/login`}>Ingresar</a>
      <a class="btn" href={demoLink()}>Pedir demostración</a>
    </nav>
  </div>
</header>
